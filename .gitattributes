* text=auto eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Git LFS 配置
# 视频文件
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.avi filter=lfs diff=lfs merge=lfs -text

*.mkv filter=lfs diff=lfs merge=lfs -text

# 图片文件（如果很大）
*.psd filter=lfs diff=lfs merge=lfs -text
*.ai filter=lfs diff=lfs merge=lfs -text

# 压缩包和模型文件
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.weights filter=lfs diff=lfs merge=lfs -text

# 运行配置可能包含现场参数，即使误加入索引也不得进入源码归档。
/config.json export-ignore

# Portable launchers must survive Windows/Linux copy and archive extraction.
scripts/portable/linux/*.sh text eol=lf
scripts/portable/windows/*.ps1 text eol=crlf
scripts/portable/deploy.ps1 text eol=crlf
/*.sh text eol=lf
/*.bat text eol=crlf
